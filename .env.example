# Veltravia Wallet — environment template
# Copy to .env (dev), .env.staging, .env.production.
# These values are baked in at build time by react-native-config.
# The backend domain is swappable WITHOUT code changes: change it here,
# in GitHub Actions secrets, and rebuild.

# development | staging | production
ENV=development

# Backend gateway (HTTPS)
API_BASE_URL=https://api.dev.veltravia.app

# WebSocket streaming endpoint (AI assistant, live prices)
WS_BASE_URL=wss://stream.dev.veltravia.app
